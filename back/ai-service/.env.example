APP_ENV=local
JEV_PROVIDER=stub
JEV_ROUTING_POLICY=pinned
JEV_MAX_ATTEMPTS=1
JEV_RETRY_ATTEMPTS=1
JEV_FALLBACK_ENABLED=false
JEV_ATTEMPT_TIMEOUT_SECONDS=90
JEV_EXECUTION_BUDGET_SECONDS=110
JEV_RETRY_BASE_DELAY_SECONDS=0.25
JEV_CIRCUIT_ENABLED=true
JEV_CIRCUIT_FAILURE_THRESHOLD=5
JEV_CIRCUIT_COOLDOWN_SECONDS=30
JEV_LIMITS_ENABLED=true
JEV_REQUESTS_PER_MINUTE=30
JEV_ATTEMPTS_PER_MINUTE=60
JEV_MAX_CONCURRENT_REQUESTS=2
JEV_MAX_CONCURRENT_CALLS=2
JEV_COST_GUARD_ENABLED=false
JEV_PRICING_MAX_AGE_DAYS=30
# With cost guard enabled, set both positive USD budgets and reviewed catalog pricing:
# JEV_REQUEST_BUDGET_USD=...
# JEV_DAILY_BUDGET_USD=...
# Optional for priority policy; ordered model IDs within JEV_PROVIDER only:
# JEV_MODEL_PRIORITY=["reviewed-model-a","reviewed-model-b"]
JEV_SERVICE_TOKEN=
GOOGLE_API_KEY=
GEMINI_MODEL=
# Optional local adapter only; Gemini remains the first production provider.
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional reviewed model registrations; real providers require a matching entry.
# JEV_MODEL_CATALOG_PATH=/absolute/path/to/model-catalog.json
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=insai-jev
LANGSMITH_ENABLED=false
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional mounted secret directory, supplied by the process environment:
# JEV_SECRETS_DIR=/run/secrets/insai
